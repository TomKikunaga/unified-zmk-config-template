//スクロール量の調整(デフォルト150)
#define ZMK_POINTING_DEFAULT_SCRL_VAL 150

#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/outputs.h>

/ {
	behaviors {
        ec_ms_l: ec_ms_h {
            compatible = "zmk,behavior-encoder-mouse-scroll";
            #sensor-binding-cells = <2>;
        };
        ec_ms_r: ec_ms_v {
            compatible = "zmk,behavior-encoder-mouse-scroll";
            #sensor-binding-cells = <2>;
        };
    };
};

//スクロールの調整
&msc {
    time-to-max-speed-ms = <0>;   // 即座に最大速度（加速なし）
    acceleration-exponent = <0>;   // 加速なし
};

/{
    combos {
        compatible = "zmk,combos";
		//左クリックのコンボ 19はJのキー 20はKのキーに相当します。
	    combo_LCLK {
            timeout-ms = <50>;
            key-positions = <19 20>;
            bindings = <&mkp LCLK>;
        };

		//右クリックのコンボ 20 K 21 L
        combo_RCLK {
            timeout-ms = <50>;
            key-positions = <20 21>;
            bindings = <&mkp RCLK>;
        };

		//ホイールクリックのコンボ 19 J 21 L
	    combo_MCLK {
            timeout-ms = <90>;
            key-positions = <19 21>;
            bindings = <&mkp MCLK>;
        };

    };
};

/{
keymap {
    compatible = "zmk,keymap";

    default_layer {
        bindings = <
            &kp TAB   &kp Q   &kp W   &kp E   &kp R   &kp T   &kp Y   &kp U   &kp I   &kp O   &kp P   &kp BSLH
            &mt LCTRL MINUS &kp A   &kp S   &kp D   &kp F   &kp G   &kp H   &kp J   &kp K   &kp L   &kp SEMI &kp SQT
            &mt LSHFT ESC   &kp Z   &kp X   &kp C   &kp V   &kp B   &kp N   &kp M   &kp COMMA &kp DOT &kp FSLH &mt RSHFT GRAVE
            &mt LALT MINUS   &mt LGUI LBKT   &lt 1 LANG2   &mt LSHFT SPACE   &lt 2 RET   &lt 1 LANG1   &lt 3 RBKT   &kp DEL
        >;
        // 左: 音量調節 (Down / Up), 右: 画面の拡大縮小 (Cmd - / Cmd +)
        sensor-bindings = <&inc_dec_kp C_VOL_DN C_VOL_UP &inc_dec_kp LG(MINUS) LG(PLUS)>;
    };
	
    layer_1 {
        bindings = <
            &trans    &kp N1    &kp N2    &kp N3    &kp LS(LA(N4))  &kp LS(LA(N5))  &kp N6    &kp LC(LEFT)  &kp LC(UP)    &kp LC(RIGHT) &kp N0    &kp DEL
            &trans    &trans    &trans    &trans    &trans    &trans    &kp PG_UP &mkp LCLK &mkp MCLK &mkp RCLK &kp LG(LBKT) &trans
            &trans    &trans    &trans    &trans    &trans    &trans    &kp PG_DN &kp LG(C) &kp LG(X) &kp LG(V) &kp LG(RBKT) &trans
            &trans    &trans    &trans    &trans    &trans    &trans    &trans    &trans
        >;
    };

    layer_2 {
        bindings = <
            &trans    &trans    &kp LS(N7) &kp LS(N8) &kp LS(N9) &kp LS(N0) &kp MINUS &kp N7    &kp N8    &kp N9    &trans    &trans
            &trans    &trans    &kp LS(N4) &kp LS(N5) &kp LS(N6) &trans    &kp EQUAL &kp N4    &kp N5    &kp N6    &trans    &trans
            &trans    &trans    &kp LS(N1) &kp LS(N2) &kp LS(N3) &trans    &kp N0    &kp N1    &kp N2    &kp N3    &trans    &trans
            &trans    &trans    &trans    &trans    &trans    &trans    &trans    &trans
        >;
    };

    layer_3 {
        bindings = <
            &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3 &bt BT_SEL 4 &bt BT_CLR &trans    &kp LA(LG(LEFT))    &trans    &kp LA(LG(RIGHT))    &trans    &trans
            &trans    &trans    &trans    &trans    &trans    &trans    &trans    &trans    &trans    &trans    &trans    &trans
            &trans    &trans    &trans    &trans    &trans    &trans    &kp LEFT  &kp DOWN  &kp UP    &kp RIGHT &trans    &trans
            &trans    &trans    &trans    &trans    &trans    &trans    &trans    &trans
        >;
    };
    scroll {
        status = "reserved";
    };

    extra2 {
        status = "reserved";
    };
};
};
